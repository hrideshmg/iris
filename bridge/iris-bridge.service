[Unit]
Description=Iris PTT Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/iris/bridge
ExecStart=/home/user/.hermes/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8807
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/user/iris/bridge
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
